<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="estades.delta"
    >

  <include package="plone.restapi" file="meta.zcml" />

  <!-- POST /++api++/@messaging-webhook — inbound guest messages -->
  <plone:service
      method="POST"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      factory=".messaging_webhook.MessagingWebhookPost"
      name="@messaging-webhook"
      permission="zope2.View"
      />

  <!-- GET /++api++/@conversations — list conversations for the current user -->
  <plone:service
      method="GET"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      factory=".conversations.ConversationsGet"
      name="@conversations"
      permission="cmf.ModifyPortalContent"
      />

  <!-- POST /++api++/@approve-response — owner approves an IA-suggested response -->
  <plone:service
      method="POST"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      factory=".approve_response.ApproveResponsePost"
      name="@approve-response"
      permission="cmf.ModifyPortalContent"
      />

  <!-- POST /++api++/@assistant-search — federated RAG retrieval (ADR-024 contract B).
       Guarded by the ASSISTANT_SERVICE_TOKEN header check inside the service. -->
  <plone:service
      method="POST"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      factory=".assistant_search.AssistantSearchPost"
      name="@assistant-search"
      permission="zope2.View"
      />

  <!-- POST /++api++/@assistant-chat — browser→Plone→assistant chat proxy
       (ADR-024 contract A). Guest-facing: a public visitor on a property
       microsite chats about the property. zope2.View (anonymous-allowed, like
       @assistant-search); abuse is gated by a per-IP rate limit inside the
       service, and the LLM service token is added server-side. -->
  <plone:service
      method="POST"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      factory=".assistant_chat.AssistantChatPost"
      name="@assistant-chat"
      permission="zope2.View"
      />

</configure>
